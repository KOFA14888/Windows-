<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        ТОКЕНЫ. Единственный файл, где задаются цвета, шрифты и размеры.
        Меняете визуальный язык симулятора — меняете только здесь.
        Значения соответствуют Windows 10 (1909/21H2), тема «Светлая», setup.
    -->

    <!-- Палитра -->
    <Color x:Key="Color.Accent">#0078D7</Color>
    <Color x:Key="Color.AccentLight">#1F8CE0</Color>
    <Color x:Key="Color.AccentPressed">#005A9E</Color>
    <Color x:Key="Color.Text.Primary">#FFFFFF</Color>
    <Color x:Key="Color.Text.Secondary">#C8C8C8</Color>
    <Color x:Key="Color.Text.Tertiary">#8A8A8A</Color>
    <Color x:Key="Color.Text.Dark">#1F1F1F</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Hover">#F2F2F2</Color>
    <Color x:Key="Color.Divider">#3A3A3A</Color>
    <Color x:Key="Color.Error">#FF4B4B</Color>
    <Color x:Key="Color.Warning">#FFB900</Color>
    <Color x:Key="Color.Success">#16C60C</Color>

    <!-- Кисти -->
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Light" Color="{StaticResource Color.AccentLight}" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="{StaticResource Color.Text.Tertiary}" />
    <SolidColorBrush x:Key="Brush.Divider" Color="{StaticResource Color.Divider}" />
    <SolidColorBrush x:Key="Brush.Error" Color="{StaticResource Color.Error}" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />
    <SolidColorBrush x:Key="Brush.Transparent" Color="Transparent" />

    <!-- Фон программы установки: тёмно-синий градиент, как у Win10 Setup -->
    <LinearGradientBrush x:Key="Brush.SetupBackground" StartPoint="0.15,0" EndPoint="0.85,1">
        <LinearGradientBrush.GradientStops>
            <GradientStop Color="#0B1B33" Offset="0" />
            <GradientStop Color="#05101F" Offset="0.55" />
            <GradientStop Color="#000000" Offset="1" />
        </LinearGradientBrush.GradientStops>
    </LinearGradientBrush>

    <!-- Шрифты -->
    <FontFamily x:Key="Font.Ui">Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Light">Segoe UI Light</FontFamily>
    <FontFamily x:Key="Font.Semibold">Segoe UI Semibold</FontFamily>
    <FontFamily x:Key="Font.Icons">Segoe MDL2 Assets</FontFamily>

    <!-- Кегли -->
    <sys:Double x:Key="Size.Title">34</sys:Double>
    <sys:Double x:Key="Size.Subtitle">15</sys:Double>
    <sys:Double x:Key="Size.Body">14</sys:Double>
    <sys:Double x:Key="Size.Small">12</sys:Double>

    <!-- Геометрия -->
    <sys:Double x:Key="Layout.PagePadding">88</sys:Double>
    <sys:Double x:Key="Layout.ContentMaxWidth">720</sys:Double>
    <sys:Double x:Key="Layout.ButtonHeight">32</sys:Double>

    <!-- Иконки Segoe MDL2 Assets -->
    <sys:String x:Key="Glyph.Chevron">&#xE76C;</sys:String>
    <sys:String x:Key="Glyph.Check">&#xE73E;</sys:String>
    <sys:String x:Key="Glyph.Warning">&#xE7BA;</sys:String>
    <sys:String x:Key="Glyph.Drive">&#xEDA2;</sys:String>
    <sys:String x:Key="Glyph.Error">&#xE783;</sys:String>

</ResourceDictionary>
