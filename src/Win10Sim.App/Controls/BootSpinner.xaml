<UserControl x:Class="Win10Sim.App.Controls.BootSpinner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Классический индикатор загрузки Windows 10: пять точек по кругу,
        затухающих по яркости, кольцо вращается против часовой стрелки.
        Один оборот — 1.6 с (значение снято с реального загрузчика).
    -->
    <Viewbox Stretch="Uniform">
        <Canvas Width="64" Height="64">
            <Canvas.RenderTransform>
                <RotateTransform x:Name="Rotation" Angle="0" CenterX="32" CenterY="32" />
            </Canvas.RenderTransform>
            <Canvas.Triggers>
                <EventTrigger RoutedEvent="Canvas.Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever">
                            <DoubleAnimation Storyboard.TargetName="Rotation"
                                             Storyboard.TargetProperty="Angle"
                                             From="0" To="360" Duration="0:0:1.6" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Canvas.Triggers>

            <Ellipse Canvas.Left="28" Canvas.Top="6"  Width="8" Height="8" Fill="#FFFFFF" Opacity="1.00" />
            <Ellipse Canvas.Left="48" Canvas.Top="18" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.82" />
            <Ellipse Canvas.Left="40" Canvas.Top="42" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.64" />
            <Ellipse Canvas.Left="16" Canvas.Top="42" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.46" />
            <Ellipse Canvas.Left="8"  Canvas.Top="18" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.28" />
        </Canvas>
    </Viewbox>
</UserControl>
