<infra:SetupScreenBase x:Class="Win10Sim.App.Screens.Setup.EditionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Win10Sim.App.Infrastructure"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             FontFamily="{StaticResource Font.Ui}">

    <Grid Background="{StaticResource Brush.SetupBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:WindowsLogo Grid.Row="0"
                              Width="26" Height="26"
                              Margin="88,52,0,0"
                              HorizontalAlignment="Left" />

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="88,0,88,0"
                    MaxWidth="540">

            <TextBlock Text="{DynamicResource L.Edition.Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{DynamicResource L.Edition.Subtitle}" Style="{StaticResource Text.Subtitle}" />

            <RadioButton x:Name="HomeOption"
                         GroupName="Edition"
                         Style="{StaticResource RadioButton.Card}"
                         Checked="OnEditionChecked"
                         Tag="Home">
                <StackPanel>
                    <TextBlock Text="Windows 10 Home" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L.Edition.Home.Description}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="ProOption"
                         GroupName="Edition"
                         Style="{StaticResource RadioButton.Card}"
                         Checked="OnEditionChecked"
                         Tag="Pro">
                <StackPanel>
                    <TextBlock Text="Windows 10 Pro" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L.Edition.Pro.Description}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </RadioButton>

            <RadioButton x:Name="EnterpriseOption"
                         GroupName="Edition"
                         Style="{StaticResource RadioButton.Card}"
                         Checked="OnEditionChecked"
                         Tag="Enterprise">
                <StackPanel>
                    <TextBlock Text="Windows 10 Enterprise" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource L.Edition.Enterprise.Description}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,3,0,0" />
                </StackPanel>
            </RadioButton>

            <TextBlock Text="{DynamicResource L.Edition.FromKey}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="88,0,88,64">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="{DynamicResource L.Back}"
                        Margin="0,0,12,0"
                        Click="OnBackClick" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="{DynamicResource L.Next}"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</infra:SetupScreenBase>
