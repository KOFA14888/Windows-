<infra:SetupScreenBase x:Class="Win10Sim.App.Screens.Setup.LanguageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Win10Sim.App.Infrastructure"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             FontFamily="{StaticResource Font.Ui}">

    <Grid Background="{StaticResource Brush.SetupBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Логотип в левом верхнем углу, как в программе установки -->
        <controls:WindowsLogo Grid.Row="0"
                              Width="26" Height="26"
                              Margin="88,52,0,0"
                              HorizontalAlignment="Left" />

        <!-- Поля выбора -->
        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="88,0,88,0"
                    MaxWidth="420">

            <TextBlock Text="{DynamicResource L.Language.Title}"
                       Style="{StaticResource Text.PageTitle}"
                       Margin="0,0,0,34" />

            <TextBlock Text="{DynamicResource L.Language.InstallLanguage}"
                       Style="{StaticResource Text.FieldLabel}" />
            <ComboBox x:Name="InstallLanguageCombo"
                      Style="{StaticResource ComboBox.Setup}"
                      SelectionChanged="OnInstallLanguageChanged" />

            <TextBlock Text="{DynamicResource L.Language.TimeFormat}"
                       Style="{StaticResource Text.FieldLabel}"
                       Margin="0,20,0,6" />
            <ComboBox x:Name="TimeFormatCombo"
                      Style="{StaticResource ComboBox.Setup}"
                      SelectionChanged="OnTimeFormatChanged" />

            <TextBlock Text="{DynamicResource L.Language.Keyboard}"
                       Style="{StaticResource Text.FieldLabel}"
                       Margin="0,20,0,6" />
            <ComboBox x:Name="KeyboardCombo"
                      Style="{StaticResource ComboBox.Setup}"
                      SelectionChanged="OnKeyboardChanged" />
        </StackPanel>

        <!-- Навигация -->
        <Grid Grid.Row="2" Margin="88,0,88,64">
            <Button Style="{StaticResource Button.Primary}"
                    Content="{DynamicResource L.Next}"
                    HorizontalAlignment="Right"
                    Click="OnNextClick" />
        </Grid>
    </Grid>
</infra:SetupScreenBase>
