<infra:SetupScreenBase x:Class="Win10Sim.App.Screens.Setup.ProductKeyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Win10Sim.App.Infrastructure"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             FontFamily="{StaticResource Font.Ui}">

    <Grid Background="{StaticResource Brush.SetupBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:WindowsLogo Grid.Row="0"
                              Width="26" Height="26"
                              Margin="88,52,0,0"
                              HorizontalAlignment="Left" />

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="88,0,88,0"
                    MaxWidth="560">

            <TextBlock Text="{DynamicResource L.Key.Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{DynamicResource L.Key.Subtitle}" Style="{StaticResource Text.Subtitle}" />

            <TextBlock Text="{DynamicResource L.Key.Label}" Style="{StaticResource Text.FieldLabel}" />
            <TextBox x:Name="ProductKeyBox"
                     Style="{StaticResource TextBox.Setup}"
                     Width="330"
                     HorizontalAlignment="Left"
                     MaxLength="29"
                     FontFamily="Consolas"
                     FontSize="16"
                     CharacterCasing="Upper"
                     TextChanged="OnKeyTextChanged" />

            <TextBlock x:Name="ErrorText"
                       Style="{StaticResource Text.Caption}"
                       Foreground="{StaticResource Brush.Error}"
                       Margin="0,10,0,0"
                       Visibility="Collapsed" />

            <TextBlock Text="{DynamicResource L.Key.Hint}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,14,0,0"
                       MaxWidth="440"
                       HorizontalAlignment="Left" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="88,0,88,64">
            <Button Style="{StaticResource Button.Link}"
                    Content="{DynamicResource L.Key.NoKey}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="OnNoKeyClick" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="{DynamicResource L.Back}"
                        Margin="0,0,12,0"
                        Click="OnBackClick" />
                <Button Style="{StaticResource Button.Primary}"
                        Content="{DynamicResource L.Next}"
                        IsDefault="True"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</infra:SetupScreenBase>
