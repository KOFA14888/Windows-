<UserControl x:Class="Win10Sim.App.Screens.Setup.EulaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             FontFamily="{StaticResource Font.Ui}">

    <Grid Background="{StaticResource Brush.SetupBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:WindowsLogo Grid.Row="0"
                              Width="26" Height="26"
                              Margin="88,52,0,0"
                              HorizontalAlignment="Left" />

        <Grid Grid.Row="1" Margin="88,0,88,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource L.Eula.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{DynamicResource L.Eula.Subtitle}"
                           Style="{StaticResource Text.Subtitle}"
                           Margin="0,0,0,14" />
            </StackPanel>

            <!-- Текст лицензии: обязательно прокрутить до конца, как в настоящем setup -->
            <Border Grid.Row="1"
                    Background="#0AFFFFFF"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="20,16"
                    MaxWidth="720"
                    HorizontalAlignment="Left"
                    MaxHeight="330">
                <ScrollViewer x:Name="EulaScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              ScrollChanged="OnEulaScrollChanged">
                    <TextBlock x:Name="EulaText"
                               Style="{StaticResource Text.Body}"
                               FontSize="13"
                               LineHeight="19"
                               Foreground="{StaticResource Brush.Text.Secondary}" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,16,0,0">
                <CheckBox x:Name="AcceptCheck"
                          Style="{StaticResource CheckBox.Setup}"
                          Content="{DynamicResource L.Eula.Accept}"
                          IsEnabled="False"
                          Checked="OnAcceptChanged"
                          Unchecked="OnAcceptChanged" />
                <TextBlock x:Name="ScrollHint"
                           Style="{StaticResource Text.Caption}"
                           Margin="30,6,0,0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" Margin="88,0,88,64">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="{DynamicResource L.Back}"
                        Margin="0,0,12,0"
                        Click="OnBackClick" />
                <Button x:Name="NextButton"
                        Style="{StaticResource Button.Primary}"
                        Content="{DynamicResource L.Next}"
                        IsEnabled="False"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
