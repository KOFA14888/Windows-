<infra:SetupScreenBase x:Class="Win10Sim.App.Screens.Setup.DiskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Win10Sim.App.Infrastructure"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             FontFamily="{StaticResource Font.Ui}">

    <infra:SetupScreenBase.Resources>
        <!-- Строка списка разделов: заголовок диска или раздел -->
        <DataTemplate x:Key="DiskRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="IconText"
                           Grid.Column="0"
                           Text="{Binding Icon}"
                           FontFamily="{StaticResource Font.Icons}"
                           FontSize="15"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Text.Secondary}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               Text="{Binding Title}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText"
                               Text="{Binding Subtitle}"
                               Style="{StaticResource Text.Caption}"
                               Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding SizeText}"
                               HorizontalAlignment="Right"
                               FontSize="13" />
                    <TextBlock Text="{Binding FreeText}"
                               Style="{StaticResource Text.Caption}"
                               HorizontalAlignment="Right"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <DataTemplate.Triggers>
                <!-- Заголовок диска: иконка диска, название жирным, без правой колонки -->
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="TitleText" Property="FontSize" Value="13" />
                    <Setter TargetName="SubtitleText" Property="FontSize" Value="11" />
                </DataTrigger>
                <!-- У раздела нет своей иконки, как и в настоящем установщике -->
                <DataTrigger Binding="{Binding IsHeader}" Value="False">
                    <Setter TargetName="IconText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TitleText" Property="Margin" Value="4,0,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Заголовки дисков не выбираются -->
        <Style x:Key="DiskRowContainer" TargetType="ListBoxItem" BasedOn="{StaticResource ListBoxItem.Setup}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="12,10,12,4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </infra:SetupScreenBase.Resources>

    <Grid Background="{StaticResource Brush.SetupBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:WindowsLogo Grid.Row="0"
                              Width="26" Height="26"
                              Margin="88,52,0,0"
                              HorizontalAlignment="Left" />

        <Grid Grid.Row="1" Margin="88,0,88,0" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock Text="{DynamicResource L.Disk.Title}" Style="{StaticResource Text.PageTitle}" />
                <TextBlock Text="{DynamicResource L.Disk.Subtitle}"
                           Style="{StaticResource Text.Subtitle}"
                           Margin="0,0,0,14" />
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#08FFFFFF"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    MaxWidth="760"
                    HorizontalAlignment="Left">
                <ListBox x:Name="DiskList"
                         Style="{StaticResource ListBox.Setup}"
                         ItemTemplate="{StaticResource DiskRowTemplate}"
                         ItemContainerStyle="{StaticResource DiskRowContainer}"
                         Height="250"
                         SelectionChanged="OnPartitionSelected" />
            </Border>

            <Grid Grid.Row="2" Margin="0,14,0,0" MaxWidth="760" HorizontalAlignment="Left">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button x:Name="FormatButton"
                        Grid.Column="0"
                        Style="{StaticResource Button.Secondary}"
                        Content="{DynamicResource L.Disk.Format}"
                        IsEnabled="False"
                        Click="OnFormatClick" />

                <Button Grid.Column="1"
                        Style="{StaticResource Button.Secondary}"
                        Content="{DynamicResource L.Disk.Refresh}"
                        Margin="10,0,0,0"
                        Click="OnRefreshClick" />

                <TextBlock x:Name="StatusText"
                           Grid.Column="2"
                           Style="{StaticResource Text.Caption}"
                           Margin="16,0,0,0"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
            </Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="88,0,88,64">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Secondary}"
                        Content="{DynamicResource L.Back}"
                        Margin="0,0,12,0"
                        Click="OnBackClick" />
                <Button x:Name="NextButton"
                        Style="{StaticResource Button.Primary}"
                        Content="{DynamicResource L.Next}"
                        IsEnabled="False"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>

        <!-- Оверлей форматирования: блокирует интерфейс, как модальное окно установщика -->
        <Border x:Name="FormatOverlay"
                Grid.RowSpan="3"
                Background="#CC000000"
                Visibility="Collapsed">
            <Border Background="#101820"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    Padding="34,28"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L.Disk.FormatTitle}"
                               FontSize="18"
                               FontFamily="{StaticResource Font.Light}"
                               Margin="0,0,0,16" />
                    <controls:BootSpinner Width="28" Height="28" HorizontalAlignment="Left" />
                    <TextBlock x:Name="FormatStageText"
                               Style="{StaticResource Text.Body}"
                               Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</infra:SetupScreenBase>
