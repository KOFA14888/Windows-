<oobe:OobeScreenBase x:Class="Win10Sim.App.Screens.Oobe.OobeWaitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oobe="clr-namespace:Win10Sim.App.Screens.Oobe"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             FontFamily="{StaticResource Font.Ui}">

    <!-- «Подождите…» — первый экран OOBE: синий фон, крупный текст, точки загрузки. -->
    <Grid Background="{StaticResource Brush.OobeBackground}">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Margin="140,0,0,0">
            <TextBlock Text="{DynamicResource L.Oobe.Wait}"
                       FontFamily="{StaticResource Font.Light}"
                       FontSize="42"
                       Foreground="{StaticResource Brush.Text.Primary}" />
            <controls:BootSpinner Width="34" Height="34"
                                  HorizontalAlignment="Left"
                                  Margin="4,28,0,0" />
        </StackPanel>

        <Button Style="{StaticResource Button.OobeLink}"
                Content="{DynamicResource L.Oobe.Accessibility}"
                IsEnabled="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="60,0,0,44"
                ToolTip="{DynamicResource L.Oobe.AccessibilityHint}" />
    </Grid>
</oobe:OobeScreenBase>
