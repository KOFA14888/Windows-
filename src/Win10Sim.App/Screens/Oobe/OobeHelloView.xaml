<oobe:OobeScreenBase x:Class="Win10Sim.App.Screens.Oobe.OobeHelloView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oobe="clr-namespace:Win10Sim.App.Screens.Oobe"
             FontFamily="{StaticResource Font.Ui}">

    <!-- «Привет» / «Hi»: короткая пауза перед финальной подготовкой. -->
    <Grid Background="{StaticResource Brush.OobeBackground}">
        <TextBlock Text="{DynamicResource L.Oobe.Hello.Title}"
                   FontFamily="{StaticResource Font.Light}"
                   FontSize="72"
                   Foreground="{StaticResource Brush.Text.Primary}"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Margin="140,0,0,0"
                   Opacity="0">
            <TextBlock.Triggers>
                <EventTrigger RoutedEvent="TextBlock.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.9" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </TextBlock.Triggers>
        </TextBlock>

        <Button Style="{StaticResource Button.OobeLink}"
                Content="{DynamicResource L.Oobe.Accessibility}"
                IsEnabled="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="60,0,0,44"
                ToolTip="{DynamicResource L.Oobe.AccessibilityHint}" />
    </Grid>
</oobe:OobeScreenBase>
