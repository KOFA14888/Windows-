<oobe:OobeScreenBase x:Class="Win10Sim.App.Screens.Oobe.OobeKeyboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oobe="clr-namespace:Win10Sim.App.Screens.Oobe"
             FontFamily="{StaticResource Font.Ui}">

    <Grid Background="{StaticResource Brush.OobeBackground}">
        <Grid VerticalAlignment="Center" HorizontalAlignment="Left" Margin="140,0,140,0" MaxWidth="620">
            <StackPanel>
                <TextBlock Text="{DynamicResource L.Oobe.Keyboard.Title}" Style="{StaticResource Text.OobeTitle}" />
                <TextBlock Text="{DynamicResource L.Oobe.Keyboard.Subtitle}" Style="{StaticResource Text.OobeSubtitle}" />

                <TextBlock Text="{DynamicResource L.Oobe.Keyboard.Primary}"
                           FontSize="14"
                           Foreground="#B8CFE3"
                           Margin="0,0,0,6" />
                <ComboBox x:Name="PrimaryCombo"
                          Style="{StaticResource ComboBox.Oobe}"
                          Width="420"
                          HorizontalAlignment="Left"
                          MaxDropDownHeight="300"
                          SelectionChanged="OnPrimaryChanged" />

                <TextBlock Text="{DynamicResource L.Oobe.Keyboard.Secondary}"
                           FontSize="14"
                           Foreground="#B8CFE3"
                           Margin="0,22,0,6" />
                <ComboBox x:Name="SecondaryCombo"
                          Style="{StaticResource ComboBox.Oobe}"
                          Width="420"
                          HorizontalAlignment="Left"
                          MaxDropDownHeight="300"
                          SelectionChanged="OnSecondaryChanged" />

                <Button Style="{StaticResource Button.Oobe}"
                        Content="{DynamicResource L.Next}"
                        Margin="0,30,0,0"
                        HorizontalAlignment="Left"
                        IsDefault="True"
                        Click="OnNextClick" />
            </StackPanel>
        </Grid>

        <Button Style="{StaticResource Button.OobeLink}"
                Content="{DynamicResource L.Oobe.Accessibility}"
                IsEnabled="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="60,0,0,44"
                ToolTip="{DynamicResource L.Oobe.AccessibilityHint}" />
    </Grid>
</oobe:OobeScreenBase>
