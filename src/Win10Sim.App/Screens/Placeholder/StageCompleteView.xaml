<UserControl x:Class="Win10Sim.App.Screens.Placeholder.StageCompleteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             FontFamily="{StaticResource Font.Ui}">

    <!--
        Честная заглушка: ЭТАП 1 закончен, экраны OOBE появятся на ЭТАПЕ 2.
        Здесь же видно, что состояние установки действительно сохранено:
        ключ, редакция и раздел перечитаны из state.json при старте процесса.
    -->
    <Grid Background="{StaticResource Brush.SetupBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <controls:WindowsLogo Grid.Row="0"
                              Width="26" Height="26"
                              Margin="88,52,0,0"
                              HorizontalAlignment="Left" />

        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Left"
                    Margin="88,0,88,0"
                    MaxWidth="680">

            <TextBlock Text="{DynamicResource L.Stage2.Title}" Style="{StaticResource Text.PageTitle}" />
            <TextBlock Text="{DynamicResource L.Stage2.Body}" Style="{StaticResource Text.Subtitle}" />

            <Border Background="#0AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" Padding="18,14">
                <StackPanel>
                    <TextBlock x:Name="KeyText" Style="{StaticResource Text.Body}" Margin="0,0,0,6" />
                    <TextBlock x:Name="EditionText" Style="{StaticResource Text.Body}" Margin="0,0,0,6" />
                    <TextBlock x:Name="DiskText" Style="{StaticResource Text.Body}" />
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2" Margin="88,0,88,64">
            <Button Style="{StaticResource Button.Link}"
                    Content="{DynamicResource L.Stage2.Exit}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Click="OnExitClick" />

            <Button Style="{StaticResource Button.Primary}"
                    Content="{DynamicResource L.Stage2.Restart}"
                    HorizontalAlignment="Right"
                    Click="OnRestartClick" />
        </Grid>
    </Grid>
</UserControl>
