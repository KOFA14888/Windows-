<UserControl x:Class="Win10Sim.App.Screens.Shell.LockScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}">

    <!--
        Экран блокировки Windows 10: размытые обои, крупные часы и дата,
        «нажмите любую клавишу» — и панель входа с аватаром и паролем.
    -->
    <Grid Background="#000000">
        <!-- Обои с размытием: BlurEffect на Image (в WPF — программное размытие,
             для статичной картинки этого достаточно). -->
        <Image x:Name="Wallpaper"
               Source="/Assets/Wallpaper.jpg"
               Stretch="UniformToFill"
               SnapsToDevicePixels="True">
            <Image.Effect>
                <BlurEffect Radius="22" KernelType="Gaussian" />
            </Image.Effect>
        </Image>

        <Border Background="#66000000" />

        <!-- Часы и дата -->
        <StackPanel x:Name="ClockPanel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="0,-80,0,0">
            <TextBlock x:Name="ClockText"
                       Text="00:00"
                       FontFamily="{StaticResource Font.Light}"
                       FontSize="96"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="DateText"
                       Text=""
                       FontSize="24"
                       Foreground="#FFFFFF"
                       HorizontalAlignment="Center"
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Подсказка «нажмите любую клавишу» -->
        <TextBlock x:Name="UnlockHint"
                   Text="{DynamicResource L.Lock.Hint}"
                   FontSize="14"
                   Foreground="#D8D8D8"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Bottom"
                   Margin="0,0,0,72" />

        <!-- Панель входа -->
        <Grid x:Name="SignInPanel"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Center"
              Margin="0,0,0,140"
              Visibility="Collapsed"
              Opacity="0">
            <StackPanel Width="360">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource Brush.Accent}">
                        <TextBlock x:Name="UserInitial"
                                   FontSize="30"
                                   Foreground="#FFFFFF"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <TextBlock x:Name="UserNameText"
                           FontSize="22"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0" />

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Background="#33FFFFFF" BorderBrush="#CCFFFFFF" BorderThickness="0,0,0,2" Height="38">
                        <PasswordBox x:Name="PasswordInput"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#FFFFFF"
                                     CaretBrush="#FFFFFF"
                                     FontSize="15"
                                     Padding="10,0"
                                     VerticalContentAlignment="Center"
                                     KeyDown="OnPasswordKeyDown" />
                    </Border>

                    <Button Grid.Column="1"
                            Width="40" Height="38"
                            Margin="6,0,0,0"
                            Background="#33FFFFFF"
                            BorderBrush="#CCFFFFFF"
                            BorderThickness="0,0,0,2"
                            Cursor="Hand"
                            ToolTip="{DynamicResource L.Lock.SignIn}"
                            Click="OnSignInClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                    <TextBlock Text="&#xE72A;"
                                               FontFamily="{StaticResource Font.Icons}"
                                               FontSize="16"
                                               Foreground="#FFFFFF"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#4DFFFFFF" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <TextBlock x:Name="PasswordPlaceholder"
                           Text="{DynamicResource L.Lock.Password}"
                           FontSize="15"
                           Foreground="#B0B0B0"
                           Margin="12,-28,0,0"
                           IsHitTestVisible="False" />

                <TextBlock x:Name="ErrorText"
                           FontSize="12"
                           Foreground="#FFB4B4"
                           HorizontalAlignment="Center"
                           Margin="0,12,0,0"
                           Visibility="Collapsed"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />

                <TextBlock x:Name="HintText"
                           FontSize="12"
                           Foreground="#A8A8A8"
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Visibility="Collapsed" />

                <Button x:Name="NoPasswordButton"
                        Style="{StaticResource Button.OobeLink}"
                        Content="{DynamicResource L.Lock.NoPassword}"
                        HorizontalAlignment="Center"
                        Margin="0,16,0,0"
                        Visibility="Collapsed"
                        Click="OnSignInClick" />
            </StackPanel>
        </Grid>

        <!-- Уголки: подсказка про Insert и специальные возможности -->
        <TextBlock Text="{DynamicResource L.Hint.Insert}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,28,22"
                   FontSize="12"
                   Foreground="#808080" />

        <Button Style="{StaticResource Button.OobeLink}"
                Content="{DynamicResource L.Oobe.Accessibility}"
                IsEnabled="False"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="44,0,0,18"
                ToolTip="{DynamicResource L.Oobe.AccessibilityHint}" />

        <!-- «Добро пожаловать» после успешного входа -->
        <Grid x:Name="WelcomePanel" Background="#E6000000" Visibility="Collapsed" Opacity="0">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="96" Height="96" CornerRadius="48" Background="{StaticResource Brush.Accent}">
                    <TextBlock x:Name="WelcomeInitial"
                               FontSize="40"
                               Foreground="#FFFFFF"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <TextBlock x:Name="WelcomeText"
                           Text="{DynamicResource L.Lock.Unlocking}"
                           FontSize="28"
                           Foreground="#FFFFFF"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
