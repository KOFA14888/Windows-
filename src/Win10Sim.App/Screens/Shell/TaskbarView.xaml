<UserControl x:Class="Win10Sim.App.Screens.Shell.TaskbarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Win10Sim.App.Controls"
             Height="48"
             FontFamily="{StaticResource Font.Ui}">

    <!--
        Панель задач Windows 10: «Пуск», поиск, кнопки запущенных программ,
        системный трей с часами. Полупрозрачный чёрный фон (#E61F1F1F) —
        акрил настоящей панели без вызова DWM API.
    -->
    <Border Background="#E61F1F1F" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Пуск -->
            <Button x:Name="StartButton"
                    Grid.Column="0"
                    Width="48" Height="48"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Пуск"
                    Click="OnStartClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent">
                            <controls:WindowsLogo Width="17" Height="17" Foreground="#FFFFFF" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Поле поиска (клик открывает «Пуск» в режиме поиска) -->
            <Border x:Name="SearchBox"
                    Grid.Column="1"
                    Width="300" Height="32"
                    Margin="0,0,4,0"
                    Background="#33FFFFFF"
                    BorderBrush="#4DFFFFFF"
                    BorderThickness="1"
                    Cursor="IBeam"
                    MouseLeftButtonDown="OnSearchClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;"
                               FontFamily="{StaticResource Font.Icons}"
                               FontSize="13"
                               Foreground="#E0E0E0"
                               VerticalAlignment="Center"
                               Margin="10,0,8,0" />
                    <TextBlock x:Name="SearchHint"
                               Grid.Column="1"
                               Text="{DynamicResource L.Shell.Search}"
                               FontSize="12"
                               Foreground="#D0D0D0"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- Кнопки запущенных приложений -->
            <ScrollViewer Grid.Column="2"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          Margin="4,0,0,0">
                <StackPanel x:Name="AppButtons" Orientation="Horizontal" />
            </ScrollViewer>

            <!-- Трей -->
            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="LanguageButton"
                        Style="{StaticResource Button.Tray}"
                        Content="РУС"
                        FontSize="12"
                        ToolTip="Раскладка клавиатуры (демонстрация)"
                        Click="OnLanguageClick" />

                <Button Style="{StaticResource Button.Tray}"
                        ToolTip="Сеть подключена"
                        Click="OnNetworkClick">
                    <TextBlock Text="&#xE701;" FontFamily="{StaticResource Font.Icons}" FontSize="15" />
                </Button>

                <Button Style="{StaticResource Button.Tray}"
                        ToolTip="Звук: 100%"
                        Click="OnSoundClick">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource Font.Icons}" FontSize="15" />
                </Button>

                <Button x:Name="ClockButton"
                        Style="{StaticResource Button.Tray}"
                        Padding="10,0"
                        Click="OnClockClick">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ClockText"
                                   Text="00:00"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="#FFFFFF" />
                        <TextBlock x:Name="DateText"
                                   Text="01.01.2026"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   Foreground="#FFFFFF" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Button.Tray}"
                        ToolTip="Центр уведомлений"
                        Click="OnNotificationsClick">
                    <TextBlock Text="&#xE7E7;" FontFamily="{StaticResource Font.Icons}" FontSize="15" />
                </Button>

                <Button Style="{StaticResource Button.Tray}"
                        ToolTip="Показать рабочий стол"
                        Click="OnShowDesktopClick">
                    <Border Width="3" Height="16" Background="#8A8A8A" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
