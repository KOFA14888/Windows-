<UserControl x:Class="Win10Sim.App.Apps.Edge.EdgeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}"
             Background="#F3F3F3">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ============ Вкладка и адресная строка ============ -->
        <Border Grid.Row="0" Background="#E8E8E8" BorderBrush="#D0D0D0" BorderThickness="0,0,0,1">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Style="{StaticResource Button.NavIcon}" Foreground="#3A3A3A" Content="&#xE72B;" ToolTip="{DynamicResource L.Edge.Back}" Click="OnBackClick" />
                <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource Button.NavIcon}" Foreground="#3A3A3A" Content="&#xE72A;" ToolTip="{DynamicResource L.Edge.Forward}" Click="OnForwardClick" />
                <Button Grid.Column="2" Style="{StaticResource Button.NavIcon}" Foreground="#3A3A3A" Content="&#xE72C;" ToolTip="{DynamicResource L.Edge.Refresh}" Click="OnRefreshClick" />

                <Border Grid.Column="3" Background="#FFFFFF" BorderBrush="#C8C8C8" BorderThickness="1" Margin="6,4" Height="26" CornerRadius="13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE774;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="11"
                                   Foreground="#1F6FB2"
                                   VerticalAlignment="Center"
                                   Margin="10,0,6,0" />
                        <TextBox x:Name="AddressBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#1A1A1A"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnAddressKeyDown" />
                    </Grid>
                </Border>

                <Button Grid.Column="4" Style="{StaticResource Button.NavIcon}" Foreground="#3A3A3A" Content="&#xE710;" ToolTip="{DynamicResource L.Edge.NewTab}" Click="OnNewTabClick" />
            </Grid>
        </Border>

        <!-- ============ Содержимое страницы ============ -->
        <Grid Grid.Row="1" Background="#FFFFFF">
            <Border x:Name="BrowserHost" />

            <!-- Заглушка, если WebView2 Runtime не установлен -->
            <Border x:Name="FallbackPanel" Background="#FAFAFA" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520" Margin="24">
                    <TextBlock Text="&#xE774;"
                               FontFamily="{StaticResource Font.Icons}"
                               FontSize="48"
                               Foreground="#9AA5B1"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="FallbackTitle"
                               Text="{DynamicResource L.Edge.NoRuntime}"
                               FontSize="13"
                               Foreground="#404040"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock x:Name="FallbackDetail"
                               FontSize="11"
                               Foreground="#707070"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <!-- Индикатор загрузки -->
            <ProgressBar x:Name="LoadingBar"
                         Height="2"
                         VerticalAlignment="Top"
                         IsIndeterminate="True"
                         Foreground="#0078D7"
                         Background="Transparent"
                         BorderThickness="0"
                         Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
