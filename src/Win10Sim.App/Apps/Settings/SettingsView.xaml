<UserControl x:Class="Win10Sim.App.Apps.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}"
             Background="#1F1F1F">

    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#2B2B2B" />
            <Setter Property="BorderBrush" Value="#3A3A3A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A8A8A8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>

        <Style x:Key="CardValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ Слева: разделы ============ -->
        <Border Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
            <StackPanel Margin="8,16">
                <StackPanel Orientation="Horizontal" Margin="10,0,0,16">
                    <TextBlock Text="&#xE713;"
                               FontFamily="{StaticResource Font.Icons}"
                               FontSize="16"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0" />
                    <TextBlock Text="{DynamicResource L.Settings.Title}"
                               FontSize="15"
                               Foreground="#FFFFFF"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="NavSystem" Style="{StaticResource Button.Sidebar}" Content="{DynamicResource L.Settings.System}" Tag="selected" Click="OnNavClick" />
                <Button x:Name="NavPersonalization" Style="{StaticResource Button.Sidebar}" Content="{DynamicResource L.Settings.Personalization}" Click="OnNavClick" />
                <Button x:Name="NavTimeLanguage" Style="{StaticResource Button.Sidebar}" Content="{DynamicResource L.Settings.TimeLanguage}" Click="OnNavClick" />
                <Button x:Name="NavAccounts" Style="{StaticResource Button.Sidebar}" Content="{DynamicResource L.Settings.Accounts}" Click="OnNavClick" />
                <Button x:Name="NavAbout" Style="{StaticResource Button.Sidebar}" Content="{DynamicResource L.Settings.About}" Click="OnNavClick" />
            </StackPanel>
        </Border>

        <!-- ============ Справа: страница ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock x:Name="PageTitle"
                           Text="{DynamicResource L.Settings.System}"
                           FontSize="24"
                           Foreground="#FFFFFF"
                           Margin="0,0,0,18" />

                <!-- Система -->
                <StackPanel x:Name="PageSystem">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.DeviceName}" />
                            <TextBlock x:Name="DeviceNameText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.DiskUsage}" />
                            <TextBlock x:Name="DiskText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Персонализация -->
                <StackPanel x:Name="PagePersonalization" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.Settings.Theme}" Style="{StaticResource CardValue}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="180" SelectionChanged="OnThemeChanged">
                                <ComboBoxItem Content="{DynamicResource L.Settings.ThemeDark}" Tag="dark" />
                                <ComboBoxItem Content="{DynamicResource L.Settings.ThemeLight}" Tag="light" />
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource SettingsCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.Settings.ClockFormat}" Style="{StaticResource CardValue}" VerticalAlignment="Center" />
                            <ComboBox x:Name="ClockBox" Grid.Column="1" Width="180" SelectionChanged="OnClockChanged">
                                <ComboBoxItem Content="{DynamicResource L.Settings.Clock24}" Tag="HH:mm" />
                                <ComboBoxItem Content="{DynamicResource L.Settings.Clock12}" Tag="h:mm" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Время и язык -->
                <StackPanel x:Name="PageTimeLanguage" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L.Settings.Language}" Style="{StaticResource CardValue}" VerticalAlignment="Center" />
                            <ComboBox x:Name="LanguageBox" Grid.Column="1" Width="180" SelectionChanged="OnLanguageChanged">
                                <ComboBoxItem Content="Русский" Tag="ru" />
                                <ComboBoxItem Content="English" Tag="en" />
                            </ComboBox>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Учётные записи -->
                <StackPanel x:Name="PageAccounts" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.User}" />
                            <TextBlock x:Name="UserText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.Password}" />
                            <TextBlock x:Name="PasswordText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- О системе -->
                <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.Edition}" />
                            <TextBlock x:Name="EditionText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.Version}" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.Processor}" />
                            <TextBlock x:Name="ProcessorText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardLabel}" Text="{DynamicResource L.Settings.Memory}" />
                            <TextBlock x:Name="MemoryText" Style="{StaticResource CardValue}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <TextBlock x:Name="AppliedText"
                           Text="{DynamicResource L.Settings.Applied}"
                           FontSize="12"
                           Foreground="#6CCB5F"
                           Margin="0,6,0,0"
                           Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
