<UserControl x:Class="Win10Sim.App.Apps.Explorer.ExplorerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}"
             Background="#1F1F1F">

    <UserControl.Resources>
        <!-- Строка списка файлов -->
        <Style x:Key="ExplorerRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.ColumnSpan="4" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#330078D7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- ============ Адресная строка и команды ============ -->
        <Border Grid.Row="0" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,0,1">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton" Style="{StaticResource Button.NavIcon}" Content="&#xE72B;" ToolTip="Назад" Click="OnBackClick" />
                <Button x:Name="ForwardButton" Grid.Column="1" Style="{StaticResource Button.NavIcon}" Content="&#xE72A;" ToolTip="Вперёд" Click="OnForwardClick" />
                <Button Grid.Column="2" Style="{StaticResource Button.NavIcon}" Content="&#xE74A;" ToolTip="Вверх" Click="OnUpClick" />
                <Button Grid.Column="3" Style="{StaticResource Button.NavIcon}" Content="&#xE72C;" ToolTip="Обновить" Click="OnRefreshClick" />

                <Border Grid.Column="4" Background="#1A1A1A" BorderBrush="#3F3F3F" BorderThickness="1" Margin="6,5" Height="28">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;"
                                   FontFamily="{StaticResource Font.Icons}"
                                   FontSize="12"
                                   Foreground="#C0C0C0"
                                   VerticalAlignment="Center"
                                   Margin="8,0,6,0" />
                        <TextBox x:Name="PathBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FFFFFF"
                                 CaretBrush="#FFFFFF"
                                 FontSize="12"
                                 VerticalContentAlignment="Center"
                                 KeyDown="OnPathKeyDown" />
                    </Grid>
                </Border>

                <Button Grid.Column="5" Style="{StaticResource Button.NavIcon}" Content="&#xE710;" ToolTip="Создать папку" Click="OnNewFolderClick" />
                <Button Grid.Column="6" Style="{StaticResource Button.NavIcon}" Content="&#xE74D;" ToolTip="Удалить" Click="OnDeleteClick" />
            </Grid>
        </Border>

        <!-- ============ Навигация + содержимое ============ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NavigationPanel" Margin="4,8" />
                </ScrollViewer>
            </Border>

            <ListBox x:Name="FileList"
                     Grid.Column="1"
                     Background="#1F1F1F"
                     BorderThickness="0"
                     ItemContainerStyle="{StaticResource ExplorerRow}"
                     MouseDoubleClick="OnItemDoubleClick"
                     KeyDown="OnListKeyDown"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ContextMenu>
                    <ContextMenu Style="{StaticResource ContextMenu.Sim}">
                        <MenuItem Header="{DynamicResource L.Explorer.Open}" Icon="&#xE8E5;" Style="{StaticResource MenuItem.Sim}" Click="OnOpenClick" />
                        <MenuItem Header="{DynamicResource L.Explorer.NewFolder}" Icon="&#xE8F4;" Style="{StaticResource MenuItem.Sim}" Click="OnNewFolderClick" />
                        <MenuItem Header="{DynamicResource L.Explorer.NewFile}" Icon="&#xE8A5;" Style="{StaticResource MenuItem.Sim}" Click="OnNewFileClick" />
                        <Separator />
                        <MenuItem Header="{DynamicResource L.Explorer.Delete}" Icon="&#xE74D;" Style="{StaticResource MenuItem.Sim}" Click="OnDeleteClick" />
                        <MenuItem Header="{DynamicResource L.Explorer.Rename}" Icon="&#xE8AC;" Style="{StaticResource MenuItem.Sim}" Click="OnRenameClick" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="90" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}"
                                       FontFamily="{StaticResource Font.Icons}"
                                       FontSize="15"
                                       Foreground="{Binding IconBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Name}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ModifiedText}"
                                       Foreground="#B0B0B0"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding SizeText}"
                                       Foreground="#B0B0B0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Пустая папка -->
            <TextBlock x:Name="EmptyLabel"
                       Grid.Column="1"
                       Text="{DynamicResource L.Explorer.Empty}"
                       FontSize="13"
                       Foreground="#8A8A8A"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Visibility="Collapsed" />
        </Grid>

        <!-- ============ Строка состояния ============ -->
        <Border Grid.Row="2" Background="#252525" BorderBrush="#3A3A3A" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#B0B0B0" VerticalAlignment="Center" />
                <TextBlock x:Name="DiskText" FontSize="11" Foreground="#B0B0B0" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ============ Диалог имени (создание / переименование) ============ -->
        <Grid x:Name="NameDialog" Grid.RowSpan="3" Background="#B3000000" Visibility="Collapsed">
            <Border Background="#2B2B2B" BorderBrush="#4A4A4A" BorderThickness="1" Padding="20" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="NameDialogTitle" FontSize="15" Foreground="#FFFFFF" Margin="0,0,0,12" />
                    <TextBox x:Name="NameDialogInput"
                             Background="#1A1A1A"
                             Foreground="#FFFFFF"
                             CaretBrush="#FFFFFF"
                             BorderBrush="#4A4A4A"
                             Height="30"
                             Padding="8,0"
                             VerticalContentAlignment="Center" />
                    <TextBlock x:Name="NameDialogError" FontSize="11" Foreground="#FFB4B4" Margin="0,8,0,0" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Style="{StaticResource Button.Secondary}" Content="{DynamicResource L.Cancel}" Margin="0,0,10,0" Click="OnNameDialogCancel" />
                        <Button Style="{StaticResource Button.Primary}" Content="ОК" Click="OnNameDialogOk" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
