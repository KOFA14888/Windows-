<UserControl x:Class="Win10Sim.App.Apps.Notepad.NotepadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource Font.Ui}"
             Background="#FFFFFF">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="28" />
            <RowDefinition Height="*" />
            <RowDefinition Height="22" />
        </Grid.RowDefinitions>

        <!-- ============ Строка меню ============ -->
        <Border Grid.Row="0" Background="#F2F2F2" BorderBrush="#D4D4D4" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" FontSize="12" Foreground="#1A1A1A">
                <MenuItem Header="{DynamicResource L.Notepad.File}" Padding="10,2">
                    <MenuItem Header="{DynamicResource L.Notepad.New}" InputGestureText="Ctrl+N" Click="OnNewClick" />
                    <MenuItem Header="{DynamicResource L.Notepad.Open}" InputGestureText="Ctrl+O" Click="OnOpenClick" />
                    <MenuItem Header="{DynamicResource L.Notepad.Save}" InputGestureText="Ctrl+S" Click="OnSaveClick" />
                    <MenuItem Header="{DynamicResource L.Notepad.SaveAs}" InputGestureText="Ctrl+Shift+S" Click="OnSaveAsClick" />
                    <Separator />
                    <MenuItem Header="{DynamicResource L.Notepad.Exit}" Click="OnExitClick" />
                </MenuItem>
                <MenuItem Header="{DynamicResource L.Notepad.Edit}" Padding="10,2">
                    <MenuItem Header="{DynamicResource L.Notepad.Undo}" InputGestureText="Ctrl+Z" Click="OnUndoClick" />
                    <Separator />
                    <MenuItem Header="{DynamicResource L.Notepad.Cut}" InputGestureText="Ctrl+X" Click="OnCutClick" />
                    <MenuItem Header="{DynamicResource L.Notepad.Copy}" InputGestureText="Ctrl+C" Click="OnCopyClick" />
                    <MenuItem Header="{DynamicResource L.Notepad.Paste}" InputGestureText="Ctrl+V" Click="OnPasteClick" />
                    <Separator />
                    <MenuItem Header="{DynamicResource L.Notepad.SelectAll}" InputGestureText="Ctrl+A" Click="OnSelectAllClick" />
                    <MenuItem Header="{DynamicResource L.Notepad.TimeDate}" InputGestureText="F5" Click="OnTimeDateClick" />
                </MenuItem>
                <MenuItem Header="{DynamicResource L.Notepad.View}" Padding="10,2">
                    <MenuItem x:Name="WordWrapItem" Header="{DynamicResource L.Notepad.WordWrap}" IsCheckable="True" IsChecked="True" Click="OnWordWrapClick" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- ============ Текст ============ -->
        <TextBox x:Name="Editor"
                 Grid.Row="1"
                 Background="#FFFFFF"
                 Foreground="#1A1A1A"
                 BorderThickness="0"
                 FontFamily="Consolas"
                 FontSize="14"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="8,6"
                 SpellCheck.IsEnabled="False"
                 SelectionChanged="OnSelectionChanged"
                 KeyDown="OnEditorKeyDown" />

        <!-- ============ Строка состояния ============ -->
        <Border Grid.Row="2" Background="#F2F2F2" BorderBrush="#D4D4D4" BorderThickness="0,1,0,0">
            <Grid Margin="10,0">
                <TextBlock x:Name="StatusText" FontSize="11" Foreground="#4A4A4A" VerticalAlignment="Center" />
                <TextBlock x:Name="PathText" FontSize="11" Foreground="#4A4A4A" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Border>

        <!-- ============ Диалог выбора файла (виртуальный диск) ============ -->
        <Grid x:Name="FileDialog" Grid.RowSpan="3" Background="#B3000000" Visibility="Collapsed">
            <Border Background="#FFFFFF" BorderBrush="#C8C8C8" BorderThickness="1" Width="520" Height="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="DialogTitle" Grid.Row="0" Text="{DynamicResource L.Notepad.Dialog.Title}"
                               FontSize="16" Foreground="#1A1A1A" Margin="0,0,0,12" />

                    <TextBlock Grid.Row="1" Text="{DynamicResource L.Notepad.Dialog.Folder}" FontSize="12" Foreground="#5A5A5A" Margin="0,0,0,4" />

                    <Grid Grid.Row="2">
                        <ListBox x:Name="FileList"
                                 BorderBrush="#D4D4D4"
                                 FontSize="12"
                                 MouseDoubleClick="OnFileListDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE8A5;"
                                                   FontFamily="{StaticResource Font.Icons}"
                                                   Foreground="#F2B15C"
                                                   Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="EmptyLabel" Text="{DynamicResource L.Notepad.Dialog.Empty}"
                                   FontSize="12" Foreground="#8A8A8A"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0">
                        <TextBlock Text="{DynamicResource L.Notepad.Dialog.FileName}" FontSize="12" Foreground="#5A5A5A" Margin="0,0,0,4" />
                        <TextBox x:Name="FileNameBox" Height="28" FontSize="12" VerticalContentAlignment="Center" Padding="6,0" BorderBrush="#C8C8C8" />
                        <TextBlock x:Name="DialogError" FontSize="11" Foreground="#C42B1C" Margin="0,6,0,0" Visibility="Collapsed" />
                    </StackPanel>

                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="{DynamicResource L.Cancel}" Width="90" Height="28" Margin="0,0,8,0" Click="OnDialogCancel" Background="#E8E8E8" BorderBrush="#C8C8C8" />
                        <Button Content="ОК" Width="90" Height="28" Click="OnDialogOk" Background="#0078D7" Foreground="#FFFFFF" BorderBrush="#0078D7" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
