<UserControl x:Class="Win10Sim.App.Apps.Cmd.CmdView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Consolas"
             Background="#0C0C0C">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Вывод команд: только чтение, прокрутка колесом и полоса прокрутки -->
        <ScrollViewer x:Name="OutputScroll"
                      Background="#0C0C0C"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      Padding="6,4">
            <TextBlock x:Name="OutputText"
                       Foreground="#CCCCCC"
                       FontFamily="Consolas"
                       FontSize="14"
                       TextWrapping="NoWrap" />
        </ScrollViewer>

        <!-- Строка ввода: приглашение + поле -->
        <Border Grid.Row="1" Background="#0C0C0C" Padding="6,0,6,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="PromptText"
                           Text="C:\&gt;"
                           Foreground="#CCCCCC"
                           FontFamily="Consolas"
                           FontSize="14"
                           VerticalAlignment="Center" />

                <TextBox x:Name="InputBox"
                         Grid.Column="1"
                         Background="Transparent"
                         Foreground="#E8E8E8"
                         CaretBrush="#E8E8E8"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="14"
                         VerticalContentAlignment="Center"
                         KeyDown="OnInputKeyDown"
                         PreviewKeyDown="OnInputPreviewKeyDown" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
