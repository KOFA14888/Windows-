<Application x:Class="Win10Sim.Template.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Базовые токены Win10. В реальном проекте переезжают в Themes/Tokens.xaml. -->
        <SolidColorBrush x:Key="Win10.Accent" Color="#0078D7" />
        <SolidColorBrush x:Key="Win10.Text.Primary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Win10.Text.Secondary" Color="#A6A6A6" />
        <FontFamily x:Key="Win10.Font">Segoe UI</FontFamily>
        <FontFamily x:Key="Win10.Icons">Segoe MDL2 Assets</FontFamily>
    </Application.Resources>
</Application>
