<Window x:Class="Win10Sim.Template.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows 10 Simulator"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Background="#000000"
        FontFamily="{StaticResource Win10.Font}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Cursor="Arrow">

    <!--
        ЭТАП 0. Тизер ЭТАПА 1: логотип Windows на чёрном фоне и вращающиеся точки.
        Здесь же видно, что HWND получает клавиатуру, а Insert — единственный выход.
    -->
    <Grid x:Name="Root">
        <Grid.Background>
            <RadialGradientBrush Center="0.5,0.42" GradientOrigin="0.5,0.42" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#0A1626" Offset="0" />
                <GradientStop Color="#000000" Offset="1" />
            </RadialGradientBrush>
        </Grid.Background>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

            <!-- Логотип: четыре белых квадрата со сдвигом, как на загрузке Win10 -->
            <Grid Width="120" Height="120" HorizontalAlignment="Center" Opacity="0">
                <Grid.Triggers>
                    <EventTrigger RoutedEvent="Grid.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0" To="1" Duration="0:0:0.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Grid.Triggers>
                <UniformGrid Columns="2" Rows="2">
                    <Rectangle Margin="5" Fill="#FFFFFF" />
                    <Rectangle Margin="5" Fill="#FFFFFF" />
                    <Rectangle Margin="5" Fill="#FFFFFF" />
                    <Rectangle Margin="5" Fill="#FFFFFF" />
                </UniformGrid>
            </Grid>

            <!-- Точки: кольцо из 5 точек, вращается 1.6 с на оборот -->
            <Canvas Width="64" Height="64" Margin="0,26,0,0" RenderTransformOrigin="0.5,0.5">
                <Canvas.RenderTransform>
                    <RotateTransform x:Name="SpinnerRotation" Angle="0" />
                </Canvas.RenderTransform>
                <Canvas.Triggers>
                    <EventTrigger RoutedEvent="Canvas.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                                                 Storyboard.TargetProperty="Angle"
                                                 From="0" To="360" Duration="0:0:1.6" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Canvas.Triggers>

                <Ellipse Canvas.Left="50" Canvas.Top="28" Width="8" Height="8" Fill="#FFFFFF" Opacity="1.0" />
                <Ellipse Canvas.Left="34.8" Canvas.Top="48.9" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.82" />
                <Ellipse Canvas.Left="10.2" Canvas.Top="40.9" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.64" />
                <Ellipse Canvas.Left="10.2" Canvas.Top="15.1" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.46" />
                <Ellipse Canvas.Left="34.8" Canvas.Top="7.1" Width="8" Height="8" Fill="#FFFFFF" Opacity="0.28" />
            </Canvas>

            <TextBlock Text="Windows 10 Simulator"
                       Margin="0,34,0,0"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource Win10.Text.Primary}"
                       HorizontalAlignment="Center" />

            <TextBlock Text="ЭТАП 0 · каркас окна и выход по Insert"
                       Margin="0,10,0,0"
                       FontSize="14"
                       Foreground="{StaticResource Win10.Text.Secondary}"
                       HorizontalAlignment="Center" />
        </StackPanel>

        <!-- Часы: доказывают, что UI живой и таймеры идут -->
        <TextBlock x:Name="ClockText"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Right"
                   Margin="0,28,34,0"
                   FontSize="14"
                   Foreground="{StaticResource Win10.Text.Secondary}" />

        <TextBlock Text="Insert — выход на рабочий стол"
                   VerticalAlignment="Bottom"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,34"
                   FontSize="13"
                   Foreground="#6B6B6B" />
    </Grid>
</Window>
